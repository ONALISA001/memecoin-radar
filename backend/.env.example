# ---- MemeCoin Radar backend configuration (all values are optional dev defaults) ----

# Database: SQLite file by default. For production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://radar:CHANGE_ME@postgres:5432/radar
DATABASE_URL=

# Security — CHANGE THESE IN PRODUCTION (§22). Never commit real values.
JWT_SECRET=dev-only-insecure-secret-change-me
# DEMO_MODE=1 enables passwordless demo login for the seeded demo user. Disable in prod:
DEMO_MODE=1
RATE_LIMIT_PER_MIN=240

# Ingestion
INGEST_INTERVAL_SECONDS=60
MAX_TRACKED_TOKENS=40

# Providers (all real keys stay server-side and are read only here, never exposed)
DEXSCREENER_ENABLED=1
# Research scope: Solana only (set 0 to also discover Ethereum/Base/BNB tokens)
SOLANA_ONLY=1
# Helius (free tier is enough): https://dashboard.helius.dev -> create key.
# Leave blank to run without real on-chain checks. Server-side only.
HELIUS_API_KEY=
HELIUS_MAX_CHECKS_PER_TICK=3
HELIUS_RECHECK_HOURS=6
# X/Twitter bearer for the Phase-2 social adapter:
X_BEARER_TOKEN=
# Solana RPC for the Phase-3 on-chain adapter:
SOLANA_RPC_URL=
# News API key for the Phase-2 news adapter:
NEWS_API_KEY=

# Universe filter (meme coins only): ignore stablecoins, anything above this market cap,
# and pools with less liquidity than this.
MAX_MCAP_USD=100000000
MIN_LIQUIDITY_USD=3000

# Real holder counts (Helius DAS getTokenAccounts, 1000 accounts per page).
# 5 pages => counts up to "5,000+" per token. Lower it to save Helius credits.
HELIUS_HOLDER_MAX_PAGES=5

# Exit analyst: for every token Helius checks, ask Jupiter for a round-trip quote
# (buy EXIT_CHECK_SOL worth, then sell it straight back). Catches "can buy, can't sell"
# honeypots and heavy sell taxes. Quotes only: no wallet, no transaction, no funds used.
# Works without a key (keyless lite endpoint). With a free key from the Jupiter developer
# portal it uses api.jup.ag instead. Set JUPITER_QUOTE_URL= (empty) to turn the check off.
JUPITER_API_KEY=
EXIT_CHECK_SOL=0.1
# JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
# Launch forensics: reads each new token's FIRST transactions once and finds bundled
# buys (same block as creation), snipers (first ~1 s), early buyers sharing one funder,
# and buyers funded by the creator. Runs only after a clean Helius check, max N per tick.
# Free Helius plan: ~50-80 credits per token, one time. On a Developer plan it uses the
# faster getTransactionsForAddress automatically (LAUNCH_USE_GTFA=1).
LAUNCH_FORENSICS_ENABLED=1
LAUNCH_FORENSICS_PER_TICK=2
LAUNCH_MAX_BUNDLE_PCT=15
LAUNCH_MAX_SNIPER_PCT=25
# Fresh-launch alerts may pass Token-2022 coins whose extensions were read and are harmless
LAUNCH_ALLOW_CLEAN_TOKEN_2022=1

# Telegram alerts (optional). Create the bot with @BotFather, add it to your channel as an admin,
# then set BOTH values in Railway -> Variables. Channel IDs look like -100xxxxxxxxxx.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Max Telegram messages per ingestion tick (flood guard)
TELEGRAM_MAX_PER_TICK=8

# Early discovery: fresh Solana pools from GeckoTerminal (free, no key; ~30 calls/min).
# NEW_POOL_SLOTS of MAX_TRACKED_TOKENS are reserved for coins found minutes after launch.
MAX_TRACKED_TOKENS=60
NEW_POOLS_ENABLED=1
NEW_POOL_SLOTS=20
NEW_POOL_MAX_AGE_H=6
NEW_POOL_MIN_LIQUIDITY_USD=8000
NEW_POOL_MIN_TXNS_H1=30

# Launch alert: one Telegram message when a fresh launch's first on-chain check is clean
# (mint + freeze authority off, standard SPL token, wallets not concentrated).
LAUNCH_ALERTS_ENABLED=1
LAUNCH_MAX_TOP10_WALLET_PCT=30
LAUNCH_MAX_TOP1_WALLET_PCT=10

# Real crypto news (publisher RSS feeds: CoinDesk, Cointelegraph, Decrypt, The Block, ...).
# Free, no key. Replaces simulated news in the FOMO / narrative / confirmation inputs.
NEWS_RSS_ENABLED=1
NEWS_REFRESH_MINUTES=10

# No free real X/Twitter source exists. 0 (default) = real coins never use simulated social:
# attention = unique buyers (GeckoTerminal), bot/wash check = trades per unique trader.
USE_SIMULATED_SOCIAL=0

# DexScreener outage: 0 (default) = keep last real data, pause scoring + paper trading.
# 1 = show a clearly-labelled simulated demo universe instead.
DEMO_FALLBACK=0

# REAL social: public Telegram call channels to watch (usernames, comma-separated).
# Read for free via each channel's public t.me/s/<channel> preview page. Empty = off.
TELEGRAM_CALL_CHANNELS=
TELEGRAM_REFRESH_MINUTES=5
TELEGRAM_DISCOVERY_SLOTS=10
