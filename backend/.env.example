# ---- MemeCoin Radar backend configuration (all values are optional dev defaults) ----

# Database: SQLite file by default. For production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://radar:CHANGE_ME@postgres:5432/radar
DATABASE_URL=

# Security — CHANGE THESE IN PRODUCTION (§22). Never commit real values.
JWT_SECRET=dev-only-insecure-secret-change-me
# DEMO_MODE=1 enables passwordless demo login for the seeded demo user. Disable in prod:
DEMO_MODE=1
RATE_LIMIT_PER_MIN=240

# Ingestion
INGEST_INTERVAL_SECONDS=60
MAX_TRACKED_TOKENS=40

# Providers (all real keys stay server-side and are read only here, never exposed)
DEXSCREENER_ENABLED=1
# X/Twitter bearer for the Phase-2 social adapter:
X_BEARER_TOKEN=
# Solana RPC for the Phase-3 on-chain adapter:
SOLANA_RPC_URL=
# News API key for the Phase-2 news adapter:
NEWS_API_KEY=
